{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manifests.lumoria.dev/1/schemas/index.json",
  "title": "Manifest index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "revision",
    "generated_at",
    "min_app_version",
    "files"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "format_version": { "type": "integer", "minimum": 1 },
    "revision": { "$ref": "defs.json#/$defs/nonempty_string" },
    "generated_at": { "type": "string", "minLength": 1 },
    "min_app_version": { "type": "string" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": { "$ref": "defs.json#/$defs/manifest_relative_path" },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "metadata": { "$ref": "defs.json#/$defs/metadata" }
  }
}
