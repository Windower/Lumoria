{
  "$schema": "https://manifests.lumoria.dev/1/schemas/runner.json",
  "id": "wine-kron4ek-staging",
  "name": "Wine Staging (kron4ek)",
  "wine_arch": "win64",
  "links": {
    "website": "https://github.com/Kron4ek/Wine-Builds",
    "license": "https://spdx.org/licenses/MIT.html"
  },
  "messages": {
    "description": "Wine builds (Staging and TkG)"
  },
  "host_arches": [
    "x86_64"
  ],
  "github_repo": "Kron4ek/Wine-Builds",
  "skip_versions": [
    "11.11",
    "11.10",
    "11.8"
  ],
  "checksum_regex": "sha256sums\\.txt$",
  "paths": {
    "bin": "bin",
    "lib": [
      "lib"
    ],
    "lib_64": [
      "lib/x86_64-linux-gnu"
    ],
    "wine_dll": [
      "lib/wine",
      "lib/wine/i386-windows",
      "lib/wine/x86_64-windows"
    ],
    "wine_unix": [
      "lib/wine/x86_64-unix",
      "lib/wine/i386-unix"
    ]
  },
  "variants": [
    {
      "id": "wow64",
      "label": "WoW64",
      "default": true,
      "asset_regex": "wine-[0-9]+\\.[0-9]+-staging-amd64-wow64\\.tar\\.xz$",
      "wine_bin": "bin/wine",
      "wineserver": "bin/wineserver",
      "binary_kind": "wow64",
      "sandbox_supported": true
    },
    {
      "id": "tkg-wow64",
      "label": "TKG WoW64",
      "asset_regex": "wine-[0-9]+\\.[0-9]+-staging-tkg-amd64-wow64\\.tar\\.xz$",
      "wine_bin": "bin/wine",
      "wineserver": "bin/wineserver",
      "binary_kind": "wow64",
      "sandbox_supported": true
    }
  ]
}
