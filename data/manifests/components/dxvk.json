{
  "$schema": "https://manifests.lumoria.dev/1/schemas/component.json",
  "id": "dxvk",
  "name": "DXVK",
  "recommended": true,
  "features": [
    "dxvk_config"
  ],
  "links": {
    "website": "https://github.com/doitsujin/dxvk",
    "license": "https://spdx.org/licenses/Zlib.html"
  },
  "messages": {
    "description": "Vulkan-based implementation of D3D8, 9, 10 and 11 for Linux / Wine. Requires a **Vulkan 1.3** or newer GPU."
  },
  "github_repo": "doitsujin/dxvk",
  "asset_regex": "dxvk-.*\\.tar\\.gz$",
  "checksum_regex": "dxvk-.*\\.(sha256|sha256sum|sha512|sha512sum)$",
  "default_version": "latest",
  "system_env_defaults": {},
  "overrides": {
    "d3d8": "n,b",
    "d3d9": "n,b",
    "d3d10core": "n,b",
    "d3d11": "n,b",
    "dxgi": "n,b"
  },
  "steps": [
    {
      "type": "copy",
      "description": "Install DXVK x32 DLLs",
      "src": "${var.COMPONENT}/x32/",
      "dst": "${var.SYS32}"
    },
    {
      "type": "copy",
      "description": "Install DXVK x64 DLLs (win64)",
      "src": "${var.COMPONENT}/x64/",
      "dst": "${var.SYSTEM32}",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    }
  ]
}
