{
  "$schema": "https://manifests.lumoria.dev/1/schemas/component.json",
  "id": "dgvoodoo",
  "name": "dgVoodoo",
  "links": {
    "website": "https://github.com/rysas/lumoria-dgvoodoo"
  },
  "messages": {
    "description": "Point in time copy of dgVoodoo, the last known version to work with FFXI on Linux. Similar to DXVK, but it translates D3D8 calls to DX11 via Windows APIs. Used to resolve some graphical issues on certain hardware."
  },
  "support": "unsupported",
  "github_repo": "rysas/lumoria-dgvoodoo",
  "asset_regex": "",
  "checksum_regex": "",
  "default_version": "latest",
  "source_archive": "zip",
  "installers": [
    "ffxi"
  ],
  "system_env_defaults": {},
  "overrides": {
    "d3d8": "n,b",
    "d3dimm": "n,b",
    "ddraw": "n,b"
  },
  "steps": [
    {
      "type": "copy",
      "description": "Install dgVoodoo D3D8.dll",
      "src": "${var.COMPONENT}/D3D8.dll",
      "dst": "${var.PREFIX}/${var.POL_DIR}"
    },
    {
      "type": "copy",
      "description": "Install dgVoodoo D3DImm.dll",
      "src": "${var.COMPONENT}/D3DImm.dll",
      "dst": "${var.PREFIX}/${var.POL_DIR}"
    },
    {
      "type": "copy",
      "description": "Install dgVoodoo DDraw.dll",
      "src": "${var.COMPONENT}/DDraw.dll",
      "dst": "${var.PREFIX}/${var.POL_DIR}"
    },
    {
      "type": "copy",
      "description": "Install dgVoodoo configuration",
      "src": "${var.COMPONENT}/dgVoodoo.conf",
      "dst": "${var.PREFIX}/${var.POL_DIR}"
    },
    {
      "type": "copy",
      "description": "Install dgVoodoo control panel",
      "src": "${var.COMPONENT}/dgVoodooCpl.exe",
      "dst": "${var.PREFIX}/${var.POL_DIR}"
    }
  ]
}
