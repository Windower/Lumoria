{
  "$schema": "https://manifests.lumoria.dev/1/schemas/component.json",
  "id": "dxvk-sarek",
  "name": "DXVK-Sarek",
  "features": ["dxvk_config"],
  "links": {
    "website": "https://github.com/pythonlover02/DXVK-Sarek",
    "license": "https://spdx.org/licenses/Zlib.html"
  },
  "messages": {
    "description": "Vulkan 1.1/1.2 based implementation of D3D3, 5, 6, 7, 8, 9, 10 and 11 for Linux/Wine/Proton. Useful for older hardware."
  },
  "github_repo": "pythonlover02/DXVK-Sarek",
  "asset_regex": "dxvk-sarek-(dyasync-)?v?[0-9].*\\.tar\\.gz$",
  "checksum_regex": "",
  "default_version": "latest",
  "system_env_defaults": {},
  "overrides": {
    "d3d8": "n,b",
    "d3d9": "n,b",
    "d3d10core": "n,b",
    "d3d11": "n,b",
    "dxgi": "n,b"
  },
  "steps": [
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x32 d3d8.dll (win64)",
      "src": "${var.COMPONENT}/x32/d3d8.dll",
      "dst": "${var.PREFIX}/drive_c/windows/syswow64",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x32 d3d9.dll (win64)",
      "src": "${var.COMPONENT}/x32/d3d9.dll",
      "dst": "${var.PREFIX}/drive_c/windows/syswow64",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x32 d3d10core.dll (win64)",
      "src": "${var.COMPONENT}/x32/d3d10core.dll",
      "dst": "${var.PREFIX}/drive_c/windows/syswow64",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x32 d3d11.dll (win64)",
      "src": "${var.COMPONENT}/x32/d3d11.dll",
      "dst": "${var.PREFIX}/drive_c/windows/syswow64",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x32 dxgi.dll (win64)",
      "src": "${var.COMPONENT}/x32/dxgi.dll",
      "dst": "${var.PREFIX}/drive_c/windows/syswow64",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x64 d3d8.dll (win64)",
      "src": "${var.COMPONENT}/x64/d3d8.dll",
      "dst": "${var.PREFIX}/drive_c/windows/system32",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x64 d3d9.dll (win64)",
      "src": "${var.COMPONENT}/x64/d3d9.dll",
      "dst": "${var.PREFIX}/drive_c/windows/system32",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x64 d3d10core.dll (win64)",
      "src": "${var.COMPONENT}/x64/d3d10core.dll",
      "dst": "${var.PREFIX}/drive_c/windows/system32",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x64 d3d11.dll (win64)",
      "src": "${var.COMPONENT}/x64/d3d11.dll",
      "dst": "${var.PREFIX}/drive_c/windows/system32",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x64 dxgi.dll (win64)",
      "src": "${var.COMPONENT}/x64/dxgi.dll",
      "dst": "${var.PREFIX}/drive_c/windows/system32",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x32 d3d8.dll (win32)",
      "src": "${var.COMPONENT}/x32/d3d8.dll",
      "dst": "${var.PREFIX}/drive_c/windows/system32",
      "when": {
        "var": {
          "ARCH": "win32"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x32 d3d9.dll (win32)",
      "src": "${var.COMPONENT}/x32/d3d9.dll",
      "dst": "${var.PREFIX}/drive_c/windows/system32",
      "when": {
        "var": {
          "ARCH": "win32"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x32 d3d10core.dll (win32)",
      "src": "${var.COMPONENT}/x32/d3d10core.dll",
      "dst": "${var.PREFIX}/drive_c/windows/system32",
      "when": {
        "var": {
          "ARCH": "win32"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x32 d3d11.dll (win32)",
      "src": "${var.COMPONENT}/x32/d3d11.dll",
      "dst": "${var.PREFIX}/drive_c/windows/system32",
      "when": {
        "var": {
          "ARCH": "win32"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x32 dxgi.dll (win32)",
      "src": "${var.COMPONENT}/x32/dxgi.dll",
      "dst": "${var.PREFIX}/drive_c/windows/system32",
      "when": {
        "var": {
          "ARCH": "win32"
        }
      }
    }
  ]
}
