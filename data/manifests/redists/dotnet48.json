{
  "$schema": "https://manifests.lumoria.dev/1/schemas/redist.json",
  "id": "dotnet48",
  "name": ".NET Framework 4.8",
  "variables": {
    "NET40": "${var.CACHE_REDIST}/dotnet48/net40",
    "NET48": "${var.CACHE_REDIST}/dotnet48/net48",
    "NETFX_ARCH": {
      "default": "x86",
      "rules": [
        {
          "value": "x64",
          "when": {
            "var": {
              "ARCH": "win64"
            }
          }
        }
      ]
    },
    "NETFX_X86": "${var.PREFIX}/drive_c/windows/Microsoft.NET/Framework/v4.0.30319",
    "NETFX_INSTALLED": "${var.NETFX_X86}/System.Net.Http.dll",
    "NETFX_REG": "${var.CACHE_REDIST}/dotnet48/netfx48.reg"
  },
  "downloads": [
    {
      "id": "dotnet40_installer",
      "url": "https://download.microsoft.com/download/9/5/A/95A9616B-7A37-4AF6-BC36-D6EA96C8DAAE/dotNetFx40_Full_x86_x64.exe",
      "dest": "${var.CACHE_REDIST}/dotnet48/dotNetFx40_Full_x86_x64.exe",
      "sha256": "65e064258f2e418816b304f646ff9e87af101e4c9552ab064bb74d281c38659f"
    },
    {
      "id": "dotnet48_installer",
      "url": "https://download.visualstudio.microsoft.com/download/pr/7afca223-55d2-470a-8edc-6a1739ae3252/abd170b4b0ec15ad0222a809b761a036/ndp48-x86-x64-allos-enu.exe",
      "dest": "${var.CACHE_REDIST}/dotnet48/ndp48-x86-x64-allos-enu.exe",
      "sha256": "95889d6de3f2070c07790ad6cf2000d33d9a1bdfc6a381725ab82ab1c314fd53"
    }
  ],
  "steps": [
    {
      "type": "extract",
      "description": "Extract .NET Framework 4.0 packages",
      "src": "${var.CACHE_REDIST}/dotnet48/dotNetFx40_Full_x86_x64.exe",
      "dst": "${var.NET40}",
      "args": [
        "netfx_Core_${var.NETFX_ARCH}.msi",
        "netfx_Extended_${var.NETFX_ARCH}.msi",
        "netfx_Core.mzz",
        "netfx_Extended.mzz"
      ],
      "when": {
        "not": {
          "file_exists": "${var.NETFX_INSTALLED}"
        }
      },
      "verify_paths": [
        "${var.NET40}/netfx_Core_${var.NETFX_ARCH}.msi",
        "${var.NET40}/netfx_Extended_${var.NETFX_ARCH}.msi",
        "${var.NET40}/netfx_Core.mzz",
        "${var.NET40}/netfx_Extended.mzz"
      ]
    },
    {
      "type": "extract",
      "description": "Extract .NET Framework 4.8 package",
      "src": "${var.CACHE_REDIST}/dotnet48/ndp48-x86-x64-allos-enu.exe",
      "dst": "${var.NET48}",
      "args": [
        "netfx_Full_${var.NETFX_ARCH}.msi",
        "netfx_Full.mzz"
      ],
      "when": {
        "not": {
          "file_exists": "${var.NETFX_INSTALLED}"
        }
      },
      "verify_paths": [
        "${var.NET48}/netfx_Full_${var.NETFX_ARCH}.msi",
        "${var.NET48}/netfx_Full.mzz"
      ]
    },
    {
      "type": "write",
      "description": "Stage .NET 4.8 release keys",
      "dst": "${var.NETFX_REG}",
      "content": [
        "Windows Registry Editor Version 5.00",
        "",
        "[HKEY_LOCAL_MACHINE\\Software\\Microsoft\\.NETFramework]",
        "\"OnlyUseLatestCLR\"=dword:00000001",
        "",
        "[HKEY_LOCAL_MACHINE\\Software\\Microsoft\\NET Framework Setup\\NDP\\v4\\Full]",
        "\"Release\"=dword:00080ea8",
        "",
        "[HKEY_LOCAL_MACHINE\\Software\\Microsoft\\NET Framework Setup\\NDP\\v4\\Full\\1033]",
        "\"Release\"=dword:00080ea8",
        "",
        "[HKEY_LOCAL_MACHINE\\Software\\Microsoft\\NET Framework Setup\\NDP\\v4\\Client]",
        "\"Release\"=dword:00080ea8",
        "",
        "[HKEY_LOCAL_MACHINE\\Software\\Microsoft\\NET Framework Setup\\NDP\\v4\\Client\\1033]",
        "\"Release\"=dword:00080ea8"
      ],
      "when": {
        "not": {
          "file_exists": "${var.NETFX_INSTALLED}"
        }
      }
    },
    {
      "type": "wineexec",
      "description": "Import .NET 4.8 release keys",
      "command": "regedit",
      "args": [
        "/S",
        "${var.NETFX_REG}"
      ],
      "when": {
        "not": {
          "file_exists": "${var.NETFX_INSTALLED}"
        }
      }
    },
    {
      "type": "wineexec",
      "description": "Import .NET 4.8 release keys (32-bit view)",
      "command": "${var.SYSWOW64}/regedit.exe",
      "args": [
        "/S",
        "${var.NETFX_REG}"
      ],
      "when": {
        "all": [
          {
            "var": {
              "ARCH": "win64"
            }
          },
          {
            "not": {
              "file_exists": "${var.NETFX_INSTALLED}"
            }
          }
        ]
      }
    },
    {
      "type": "dll_override",
      "description": "Set mscoree to native",
      "command": "mscoree",
      "mode": "native",
      "when": {
        "not": {
          "file_exists": "${var.NETFX_INSTALLED}"
        }
      }
    },
    {
      "type": "msi_install",
      "description": "Install .NET Framework 4.0 core (mscoree, InstallRoot)",
      "src": "${var.NET40}/netfx_Core_${var.NETFX_ARCH}.msi",
      "when": {
        "not": {
          "file_exists": "${var.NETFX_INSTALLED}"
        }
      },
      "verify_paths": [
        "${var.SYSTEM32}/mscoree.dll",
        "${var.NETFX_X86}/mscoreei.dll"
      ]
    },
    {
      "type": "msi_install",
      "description": "Install .NET Framework 4.0 extended",
      "src": "${var.NET40}/netfx_Extended_${var.NETFX_ARCH}.msi",
      "when": {
        "not": {
          "file_exists": "${var.NETFX_INSTALLED}"
        }
      }
    },
    {
      "type": "msi_install",
      "description": "Install .NET Framework 4.8",
      "src": "${var.NET48}/netfx_Full_${var.NETFX_ARCH}.msi",
      "when": {
        "not": {
          "file_exists": "${var.NETFX_INSTALLED}"
        }
      },
      "verify_paths": [
        "${var.NETFX_X86}/clr.dll",
        "${var.NETFX_X86}/mscorlib.dll",
        "${var.NETFX_INSTALLED}"
      ]
    },
    {
      "type": "delete",
      "description": "Remove extracted .NET payloads",
      "args": [
        "${var.NET40}",
        "${var.NET48}",
        "${var.NETFX_REG}"
      ]
    }
  ]
}
