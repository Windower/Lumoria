{
  "$schema": "https://manifests.lumoria.dev/1/schemas/redist.json",
  "id": "d3dcompiler_43",
  "name": "d3dcompiler_43",
  "downloads": [
    {
      "id": "directx_jun2010",
      "url": "https://files.holarse-linuxgaming.de/mirrors/microsoft/directx_Jun2010_redist.exe",
      "dest": "${var.CACHE_REDIST}/directx9/directx_Jun2010_redist.exe",
      "sha256": "8746ee1a84a083a90e37899d71d50d5c7c015e69688a466aa80447f011780c0d"
    }
  ],
  "steps": [
    {
      "type": "dll_override",
      "description": "Set d3dcompiler_43 to native",
      "command": "d3dcompiler_43",
      "mode": "native"
    },
    {
      "type": "cabextract",
      "description": "Extract d3dcompiler_43 x86 cab",
      "src": "${var.CACHE_REDIST}/directx9/directx_Jun2010_redist.exe",
      "args": [
        "Jun2010_D3DCompiler_43_x86.cab"
      ],
      "dst": "${var.CACHE_REDIST}/d3dcompiler_43/Jun2010_D3DCompiler_43_x86.cab"
    },
    {
      "type": "cabextract",
      "description": "Extract d3dcompiler_43.dll (x86 -> syswow64)",
      "src": "${var.CACHE_REDIST}/d3dcompiler_43/Jun2010_D3DCompiler_43_x86.cab",
      "args": [
        "d3dcompiler_43.dll"
      ],
      "dst": "${var.SYSWOW64}/d3dcompiler_43.dll",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "cabextract",
      "description": "Extract d3dcompiler_43.dll (x86 -> system32)",
      "src": "${var.CACHE_REDIST}/d3dcompiler_43/Jun2010_D3DCompiler_43_x86.cab",
      "args": [
        "d3dcompiler_43.dll"
      ],
      "dst": "${var.SYSTEM32}/d3dcompiler_43.dll",
      "when": {
        "var": {
          "ARCH": "win32"
        }
      }
    },
    {
      "type": "cabextract",
      "description": "Extract D3DCompiler 43 x64 cab",
      "src": "${var.CACHE_REDIST}/directx9/directx_Jun2010_redist.exe",
      "args": [
        "Jun2010_D3DCompiler_43_x64.cab"
      ],
      "dst": "${var.CACHE_REDIST}/d3dcompiler_43/Jun2010_D3DCompiler_43_x64.cab",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "cabextract",
      "description": "Extract d3dcompiler_43.dll (x64 -> system32)",
      "src": "${var.CACHE_REDIST}/d3dcompiler_43/Jun2010_D3DCompiler_43_x64.cab",
      "args": [
        "d3dcompiler_43.dll"
      ],
      "dst": "${var.SYSTEM32}/d3dcompiler_43.dll",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    }
  ]
}
