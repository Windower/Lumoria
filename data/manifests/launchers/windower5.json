{
  "$schema": "https://manifests.lumoria.dev/1/schemas/launcher.json",
  "id": "windower5",
  "name": "Windower 5",
  "default": false,
  "icon": "windower-app",
  "support": "experimental",
  "links": {
    "website": "https://www.windower.net/",
    "docs": "https://docs.windower.net/",
    "help": "https://discord.gg/aUrHCvk"
  },
  "messages": {
    "new-prefix": [
      {
        "style": "info",
        "body": "Windower 5 is a preview of the next major version of Windower. It is still in active development and is not as fully featured as Windower 4."
      }
    ]
  },
  "variables": {
    "BRAND": "#339933",
    "WINE_USERPROFILE_HOST": "${winepath:%USERPROFILE%}",
    "WINDOWER": {
      "default": "drive_c/Program Files (x86)/Windower Dev",
      "rules": [
        {
          "value": "drive_c/Program Files/Windower Dev",
          "when": {
            "var": {
              "ARCH": "win32"
            }
          }
        }
      ]
    }
  },
  "entrypoints": [
    {
      "id": "windower",
      "name": "Windower",
      "exe": "${var.WINDOWER}/windower.exe",
      "args": [
        "launch",
        "default"
      ],
      "default": true
    }
  ],
  "downloads": [
    {
      "id": "windower5",
      "url": "https://files.windower.net/5/core/test/windower.msi",
      "dest": "${var.CACHE}/windower5/windower.msi"
    }
  ],
  "redists": [
    "dotnet48",
    "vcrun2022"
  ],
  "steps": [
    {
      "type": "wineexec",
      "description": "Install Windower 5",
      "command": "msiexec",
      "args": [
        "-q",
        "-i",
        "${var.CACHE}/windower5/windower.msi"
      ],
      "working_dir": "${var.CACHE}/windower5",
      "when": {
        "not": {
          "file_exists": "${var.PREFIX}/${var.WINDOWER}/windower.exe"
        }
      },
      "verify_paths": [
        "${var.PREFIX}/${var.WINDOWER}/windower.exe"
      ],
      "allow_nonzero_exit": true
    },
    {
      "type": "wineexec",
      "description": "Configure Windower 5",
      "command": "${var.WINDOWER}/windower.exe",
      "args": [
        "save",
        "default",
        "--overwrite"
      ],
      "verify_paths": [
        "${var.WINE_USERPROFILE_HOST}/AppData/Local/Windower/profiles.xml"
      ],
      "allow_nonzero_exit": true
    }
  ]
}
