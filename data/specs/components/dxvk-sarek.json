{
  "id": "dxvk-sarek",
  "name": "DXVK-Sarek",
  "github_repo": "pythonlover02/DXVK-Sarek",
  "asset_regex": "dxvk-sarek-(dyasync-)?v.*\\.tar\\.gz$",
  "checksum_regex": "",
  "default_version": "latest",
  "system_env_defaults": {},
  "overrides": {
    "d3d8": "n,b",
    "d3d9": "n,b",
    "d3d10core": "n,b",
    "d3d11": "n,b",
    "dxgi": "n,b"
  },
  "steps": [
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x32 d3d8.dll (win64)",
      "src": "${var.COMPONENT}/x32/d3d8.dll",
      "dst": "${var.PREFIX}/drive_c/windows/syswow64",
      "when": {
        "var": {
          "ARCH": "win64"
        }
      }
    },
    {
      "type": "copy",
      "description": "Install DXVK-Sarek x32 d3d9.dll (win64)",
      "src": "${var.COMPONENT}/x32/d3d9.dll",
