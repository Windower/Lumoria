{
  "id": "calibri",
  "name": "Calibri",
  "downloads": [
    {
      "id": "pptviewer",
      "url": "https://share.lumoria.dev/redists/pptfonts/PowerPointViewer.exe",
      "dest": "${var.CACHE_REDIST}/pptfonts/PowerPointViewer.exe",
      "sha256": "249473568eba7a1e4f95498acba594e0f42e6581add4dead70c1dfb908a09423"
    }
  ],
  "steps": [
    {
      "type": "cabextract",
      "description": "Extract ppviewer.cab",
      "src": "${var.CACHE_REDIST}/pptfonts/PowerPointViewer.exe",
      "args": [
        "ppviewer.cab"
      ],
      "dst": "${var.CACHE_REDIST}/pptfonts/ppviewer.cab"
    },
    {
      "type": "fonts",
      "description": "Install Calibri",
      "dst": "${var.FONTS}",
      "args": [
        "${var.CACHE_REDIST}/pptfonts/ppviewer.cab"
      ],
      "font_registrations": [
        "calibri.ttf|Calibri",
        "calibrib.ttf|Calibri Bold",
        "calibrii.ttf|Calibri Italic",
        "calibriz.ttf|Calibri Bold Italic"
      ],
      "when": {
        "not": {
          "file_exists": "${var.FONTS}/calibri.ttf"
        }
      }
    }
  ]
}
