vapi_dir = meson.current_source_dir() / 'vapi'

lumoria_deps = [
  config_dep,
  dependency('gtk4'),
  dependency('glib-2.0'),
  dependency('gio-unix-2.0'),
  dependency('libadwaita-1', version: '>= 1.7'),
  dependency('json-glib-1.0'),
  dependency('libxml-2.0'),
  dependency('libsoup-3.0'),
  dependency('gee-0.8'),
  dependency('libarchive'),
  dependency('vte-2.91-gtk4'),
  dependency('manette-0.2'),
  dependency('libportal'),
  dependency('libportal-gtk4'),
  dependency('libgit2-glib-1.0'),
]

cc = meson.get_compiler('c')
mspack_c_dep = cc.find_library('mspack')
mspack_shim = files('native/mspack-shim.c')

cargo = find_program('cargo')
find_program('rustc')
native_build = find_program(meson.project_source_root() / 'tools/build-native.sh')
native_lib = custom_target(
  'lumoria-native',
  output: 'liblumoria_native.a',
  input: files(
    meson.project_source_root() / 'rust/native/Cargo.toml',
    meson.project_source_root() / 'rust/native/Cargo.lock',
    meson.project_source_root() / 'rust/native/src/lib.rs',
    meson.project_source_root() / 'rust/native/src/ffi.rs',
    meson.project_source_root() / 'rust/native/src/jsonschema.rs',
    meson.project_source_root() / 'rust/native/src/msi.rs',
    meson.project_source_root() / 'rust/native/src/sevenz.rs',
  ),
  command: [
    native_build,
    meson.project_source_root() / 'rust/native/Cargo.toml',
    meson.project_build_root() / 'rust',
    '@OUTPUT@',
  ],
  console: true,
)
native_inc = include_directories('../rust/native')
native_dep = declare_dependency(
  sources: native_lib,
  include_directories: native_inc,
  link_args: [
    native_lib.full_path(),
    '-ldl',
    '-lpthread',
    '-lm',
  ],
)

lumoria_vala_args = [
  '--vapidir', vapi_dir,
  '--pkg', 'posix',
  '--pkg', 'gio-unix-2.0',
  '--pkg', 'libarchive',
  '--pkg', 'libxml-2.0',
  '--pkg', 'mspack',
  '--pkg', 'libportal',
  '--pkg', 'libportal-gtk4',
  '--pkg', 'libgit2-glib-1.0',
  '--pkg', 'lumoria-native',
]

executable(
  'lumoria',
  lumoria_sources, mspack_shim,
  vala_args: lumoria_vala_args,
  include_directories: [config_inc, native_inc],
  dependencies: [lumoria_deps, mspack_c_dep, native_dep],
  install: true,
)
